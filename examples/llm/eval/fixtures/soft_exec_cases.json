        {"m.released": 2003, "m.title": "The Matrix Reloaded"}
      ],
      "expected": {
        "exact_exec_match": false,
        "exact_jaccard": 0.0,
        "soft_exec_match": true,
        "soft_jaccard": 1.0,
        "soft_f1": 1.0,
        "has_entity_jaccard": false
      }
    },
