{
  "start": {
    "class": "Product",
    "alias": "product"
  },
  "return": [
    {
      "alias": "supplier",
      "property": "name",
      "as_name": "supplier_name"
    }
  ],
  "filter": [
    {
      "alias": "product",
      "property": "sku",
      "op": "eq",
      "value": "SPX-100"
    }
  ],
  "limit": 20,
  "traverse": [
    {
      "relationship": "has_part",
      "direction": "out",
      "to": {
        "class": "Part",
        "alias": "part"
      }
    },
    {
      "relationship": "supplied_by",
      "direction": "out",
      "to": {
        "class": "Supplier",
        "alias": "supplier"
      }
    }
  ]
}
