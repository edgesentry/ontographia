{
  "name": "@edgesentry/ontographia-wasm",
  "version": "0.1.10",
  "description": "Browser WebAssembly build of Ontographia. Compiles ontology bytes plus Intent JSON into parameter-bound Cypher 25. No Node addon, no server call, no LLM.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./ontographia_wasm.wasm": "./ontographia_wasm.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "ontographia_wasm.wasm",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bash scripts/build-package.sh --pack",
    "test": "node scripts/smoke-packed.mjs",
    "prepack": "bash scripts/build-package.sh --source-only",
    "prepublishOnly": "node ../../scripts/refuse-wasm-npm-publish.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgesentry/ontographia.git",
    "directory": "bindings/wasm"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ontology",
    "cypher",
    "neo4j",
    "wasm",
    "webassembly",
    "browser"
  ]
}
