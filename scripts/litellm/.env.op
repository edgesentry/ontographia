# 1Password env template for local LiteLLM (committed; contains no secret values).
# Secrets are op:// references resolved at run time by `op run --env-file`.
# Vault `ontographia-dev` is created by the operator (see docs/litellm-local.md).

# --- LiteLLM proxy ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=op://ontographia-dev/litellm-upstream/LITELLM_MASTER_KEY

# --- Upstream providers ---
OPENAI_API_KEY=op://ontographia-dev/litellm-upstream/OPENAI_API_KEY
GEMINI_API_KEY=op://ontographia-dev/litellm-upstream/GEMINI_API_KEY
ANTHROPIC_API_KEY=op://ontographia-dev/litellm-upstream/ANTHROPIC_API_KEY
CURSOR_API_KEY=op://ontographia-dev/litellm-upstream/CURSOR_API_KEY

# --- Ontographia E2E defaults when using LiteLLM (non-secret) ---
ONTOGRAPHIA_LLM_BACKEND=openai
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_MODEL=ontographia-openai

# --- Neo4j (run_llm_e2e --execute) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=op://ontographia-dev/neo4j-local/password
