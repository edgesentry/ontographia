# LiteLLM proxy for local Ontographia LLM E2E (not used in CI).
#
# Secrets live in 1Password, not in git. The committed template is
#   scripts/litellm/.env.op
# which contains only op:// references plus non-secret defaults.
#
# Vault (operator creates; docs only): ontographia-dev
#   item litellm-upstream: LITELLM_MASTER_KEY, OPENAI_API_KEY, GEMINI_API_KEY,
#                          ANTHROPIC_API_KEY, CURSOR_API_KEY
#   item neo4j-local:      password
#
# Run (scripts wrap this):
#   op run --env-file scripts/litellm/.env.op -- ./scripts/litellm/start.sh
# Use another template: LITELLM_OP_ENV_FILE=/path/to/file.op
#
# This file only documents the variable names; do not put real values here.
# Full guide: docs/litellm-local.md

# --- LiteLLM proxy ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=op://ontographia-dev/litellm-upstream/LITELLM_MASTER_KEY

# --- Upstream providers (route only the ones you use) ---
OPENAI_API_KEY=op://ontographia-dev/litellm-upstream/OPENAI_API_KEY
GEMINI_API_KEY=op://ontographia-dev/litellm-upstream/GEMINI_API_KEY
# Gemini versions are pinned per alias in config.yaml (ontographia-gemini-3.7 / ontographia-gemini-3.8).
# Used by model alias `ontographia-cursor` (Anthropic)
ANTHROPIC_API_KEY=op://ontographia-dev/litellm-upstream/ANTHROPIC_API_KEY
# Optional: Cursor Cloud Agents pass-through (api.cursor.com/v0/* via proxy /cursor)
CURSOR_API_KEY=op://ontographia-dev/litellm-upstream/CURSOR_API_KEY

# --- Ontographia E2E defaults when using LiteLLM ---
ONTOGRAPHIA_LLM_BACKEND=openai
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# Switch with: source scripts/litellm/use-provider.sh openai|gemini-3.7|gemini-3.8|cursor
OPENAI_MODEL=ontographia-openai

# --- Neo4j (run_llm_e2e --execute) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=op://ontographia-dev/neo4j-local/password
