# LiteLLM proxy for local Ontographia LLM E2E (not used in CI by default).
#
# Committed secrets use dotenvx ciphertext at:
#   scripts/litellm/.env.encrypted
# Private key (never commit; outside the repo):
#   ~/.config/ontographia/dotenv.keys
#
# First-time encryption (maintainer / local setup):
#   1. Install dotenvx:  curl -sfS https://dotenvx.sh | sh
#      macOS: brew tap dotenvx/brew && brew trust dotenvx/brew && brew install dotenvx
#   2. Copy this file and fill in real keys:
#        cp -i scripts/litellm/env.example scripts/litellm/.env.encrypted
#        # edit scripts/litellm/.env.encrypted (or start from an existing plaintext .env)
#   3. Encrypt in place (writes .env.keys next to the file by default):
#        dotenvx encrypt -f scripts/litellm/.env.encrypted
#   4. Move the private key outside the repo:
#        mkdir -p ~/.config/ontographia
#        mv scripts/litellm/.env.keys ~/.config/ontographia/dotenv.keys
#        chmod 600 ~/.config/ontographia/dotenv.keys
#   5. Commit only the ciphertext:
#        git add scripts/litellm/.env.encrypted
#      Do NOT commit .env.keys, *.keys, or plaintext scripts/litellm/.env
#
# Run (scripts wrap this):
#   dotenvx run -f scripts/litellm/.env.encrypted \
#     -fk ~/.config/ontographia/dotenv.keys -- ./scripts/litellm/start.sh
#
# Full guide: docs/litellm-local.md

# --- LiteLLM proxy ---
LITELLM_PORT=4000
# Clients (run_llm_e2e, Cursor IDE) send this as Bearer token to the proxy.
LITELLM_MASTER_KEY=sk-litellm-local-dev

# --- Upstream providers (set only the ones you route through LiteLLM) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# Gemini versions are pinned per alias in config.yaml (ontographia-gemini-3.7 / ontographia-gemini-3.8).
# Used by model alias `ontographia-cursor` (Anthropic — typical Cursor IDE backend via LiteLLM)
ANTHROPIC_API_KEY=
# Optional: Cursor Cloud Agents pass-through (api.cursor.com/v0/* via proxy /cursor)
CURSOR_API_KEY=

# --- Ontographia E2E defaults when using LiteLLM ---
ONTOGRAPHIA_LLM_BACKEND=openai
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# OPENAI_API_KEY above is the *upstream* OpenAI key for the proxy.
# Clients talking to the proxy use LITELLM_MASTER_KEY (see use-provider.sh).
# Switch with: source scripts/litellm/use-provider.sh openai|gemini-3.7|gemini-3.8|cursor
OPENAI_MODEL=ontographia-openai

# --- Neo4j (run_llm_e2e --execute) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ontographia
